# ============================================================
# 环境变量模板 —— 复制为 .env 后填入真实值
# 真实 .env 含敏感信息，已被 .gitignore 排除，严禁提交
# ============================================================

# ---- 数据库（必需）----
# Prisma SQLite 连串；相对 schema.prisma 所在目录解析
# Linux/macOS 沙箱与 Windows 本地均可使用项目内相对路径写法：
#   DATABASE_URL=file:../db/custom.db
DATABASE_URL=file:../db/custom.db

# ---- LLM 通道（可选；内置/DeepSeek 双通道）----
# builtin = 平台内置模型（默认，无需 key）；deepseek = DeepSeek 官方 API
# LLM_PROVIDER=builtin

# DeepSeek 通道配置（LLM_PROVIDER=deepseek 时必填）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_VISION_MODEL=deepseek-flash

# ---- PDF 字体（可选；一般无需配置）----
# 纯系统字体方案，仓库不捆绑字体文件；.ttf/.otf/.ttc 集合均支持：
#   Windows 微软雅黑/宋体/黑体/等线 · macOS 苹方/宋体 · Linux Noto/文泉驿 + fontconfig 自动探测
# 自定义字体目录（优先级最高）：
# PDF_FONT_DIR=C:\my-fonts
# 也可将字体文件放入项目 assets/fonts/ 目录（该目录已 gitignore 不入库）
